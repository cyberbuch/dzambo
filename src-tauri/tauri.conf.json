{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dzambo",
  "version": "0.1.0",
  "identifier": "cf.dzambo.desktop",
  "build": {
    "frontendDist": "../src-tauri/ui",
    "devUrl": "http://127.0.0.1:3022"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dzambo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "category": "Finance",
    "shortDescription": "dzambo счетоводство",
    "longDescription": "dzambo — счетоводна програма (тънък клиент към сървър)",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}